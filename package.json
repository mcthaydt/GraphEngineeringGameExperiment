{
  "name": "graph-engineering-game-experiment",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --project unit --project browser",
    "capture": "vitest run --project capture && node scripts/clip.ts",
    "measure": "node scripts/measure-frames.ts",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic": "0.21.0",
    "@pixi/3d": "0.1.0",
    "effect": "3.22.2",
    "koota": "0.6.6",
    "pixi.js": "8.23.0",
    "smol-toml": "1.9.1",
    "svelte": "5.57.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.1.0",
    "eslint": "10.15.0",
    "playwright": "1.63.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
